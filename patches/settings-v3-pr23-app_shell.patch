+}
+
+function applySettingsV3AdvancedState(root) {
+  const scope = root || document;
+  const bodiesOpen = !!scope.querySelector("#rm-sv3-advanced-bodies[open]");
+  const orbsOpen = !!scope.querySelector("#rm-sv3-advanced-orbs[open]");
