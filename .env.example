# Relocation App local environment example
# Copy this file to .env.local for real local secrets.
# NEVER commit .env.local.

# Supabase
SUPABASE_URL=https://dpmtmmryvlftfahipowa.supabase.co
SUPABASE_ANON_KEY=

# Geoapify
GEOAPIFY_API_KEY=

# City / language defaults
CITY_PROVIDER=geoapify
DEFAULT_LANGUAGE=en
DEFAULT_COUNTRY_DISPLAY=en

# Timezone
TIMEZONE_PROVIDER=iana
TIMEZONE_LOOKUP_MODE=offline_timezonefinder_plus_zoneinfo

# Server
PORT=8004

# --- Local relay loop (scripts/relay_local_loop.py) ---
# CURSOR_API_KEY=          # required: Cursor → Settings → Integrations
# OPENAI_API_KEY=          # planner option A (gpt-4o-mini, ~pennies/task)
# ANTHROPIC_API_KEY=       # planner option B (claude-haiku, ~pennies/task)
# TELEGRAM_BOT_TOKEN=      # optional pings (you already have in .env.local)
# TELEGRAM_CHAT_ID=
# RELAY_LOCAL_PUSH=1       # git push after each task

# API_ROBOT=              # Anthropic key (alias for ANTHROPIC_API_KEY)
